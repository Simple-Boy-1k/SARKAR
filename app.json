{
  "name": "Gemini AI Telegram Bot",
  "description": "A powerful Telegram AI chatbot powered by Google Gemini with custom styled inline buttons and support links.",
  "keywords": ["telegram", "bot", "gemini", "ai", "python", "heroku"],
  "env": {
    "BOT_TOKEN": {
      "description": "Your Telegram Bot Token from @BotFather",
      "value": "",
      "required": true
    },
    "GEMINI_API_KEY": {
      "description": "Your Google Gemini API Key from Google AI Studio",
      "value": "",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID (Numeric format, e.g. 123456789)",
      "value": "0",
      "required": false
    },
    "OWNER_USERNAME": {
      "description": "Your Telegram username without @ symbol",
      "value": "",
      "required": false
    },
    "SUPPORT_CHAT_URL": {
      "description": "URL to your support chat group",
      "value": "",
      "required": false
    },
    "SUPPORT_CHANNEL_URL": {
      "description": "URL to your support channel",
      "value": "",
      "required": false
    },
    "UPDATES_CHANNEL_URL": {
      "description": "URL to your updates channel",
      "value": "",
      "required": false
    },
    "START_IMAGE_URL": {
      "description": "Direct image URL for start / welcome screen",
      "value": "https://raw.githubusercontent.com/AashishTechs/Deep-Emotion/main/Welcome.jpg?v=2",
      "required": false
    },
    "OUR_BOTS_URL": {
      "description": "URL showcasing your other bots",
      "value": "",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ]
}
